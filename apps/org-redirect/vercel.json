    {
      "source": "/urunler/cami-ayet-hadis/:path*",
      "destination": "https://www.vakitmatik.com.tr/ayet-hadis-panosu/",
      "statusCode": 301
    },
    {
      "source": "/programlar.html",
      "destination": "https://www.vakitmatik.com.tr/destek/vakitmatik-ayarlama/",
      "statusCode": 301
    },
    {
      "source": "/kilavuzlar.html",
