      "destination": "https://www.vakitmatik.com.tr/",
      "statusCode": 301
    },
    {
      "source": "/robots.txt",
      "destination": "https://www.vakitmatik.com.tr/robots.txt",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://www.vakitmatik.com.tr/sitemap.xml",
      "statusCode": 301
    },
    {
