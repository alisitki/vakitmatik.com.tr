      "statusCode": 301
    },
    {
      "source": "/urunler/ezan-okuyan-saat/:path*",
      "destination": "https://www.vakitmatik.com.tr/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://www.vakitmatik.com.tr/",
      "statusCode": 301
    }
  ]
}
